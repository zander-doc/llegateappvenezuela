# Conexión a PostgreSQL (Neon, un VPS o local). Solo la usa este servidor.
# Copia esta cadena de la consola del proveedor; no la publiques en la web.
DATABASE_URL=postgres://usuario:clave@host:5432/llegate?sslmode=require
# 1 fuerza TLS. Vacío = se activa solo para hosts conocidos (neon.tech, etc.).
DATABASE_SSL=
DATABASE_POOL_SIZE=5

PORT=3000
# URL pública de esta API; se usa para firmar los enlaces de descarga.
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173

# Sesiones propias. Genera el secreto con: openssl rand -hex 32
AUTH_JWT_SECRET=
AUTH_ACCESS_TTL_SEGUNDOS=3600
AUTH_REFRESH_TTL_DIAS=30

# Códigos OTP. El pepper es independiente del JWT (si falta, se usa el JWT).
OTP_SECRET=
OTP_TTL_MINUTOS=10
OTP_MAX_INTENTOS=5
# Ventana deslizante en memoria por teléfono, IP e intentos de verificación.
OTP_MAX_POR_TELEFONO=3
OTP_MAX_POR_IP=8
OTP_MAX_VERIFICACIONES=6
OTP_VENTANA_MINUTOS=10
# Solo desarrollo: sin proveedor, imprime el código en el log. En producción
# déjalo en 0 y configura WhatsApp o Twilio; si no, /auth/otp responde 503.
OTP_LOG_EN_DESARROLLO=1

# WhatsApp Cloud API (primer canal). La plantilla debe estar aprobada en Meta.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_OTP_TEMPLATE=llegate_otp
WHATSAPP_OTP_LANGUAGE=es
WHATSAPP_API_VERSION=v21.0

# SMS por Twilio (segundo canal).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Documentos de conductores. "local" guarda en disco; "r2" usa Cloudflare R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_BUCKET=documentos-conductores
# Firma los enlaces temporales de descarga. Si falta, se usa AUTH_JWT_SECRET.
ARCHIVOS_SECRET=
ARCHIVOS_URL_SEGUNDOS=900

# Cloudflare R2 (solo con STORAGE_DRIVER=r2). R2_ENDPOINT es opcional.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Recargas con pasarelas. Sin estas variables la API responde 503 en ese
# método y la web solo muestra los métodos configurados.
#
# Clave para confirmar pagos desde el webhook de Binance.
# Debe coincidir con el SHA-256 guardado en configuracion_pagos.clave_servidor_hash.
PAGOS_CLAVE_SERVIDOR=

# Pago Móvil semiautomático (revisión manual)
PAGO_MOVIL_BANCO=
PAGO_MOVIL_TELEFONO=
PAGO_MOVIL_CEDULA=
PAGO_MOVIL_TITULAR=
PAGO_MOVIL_TASA_BS=
PAGO_MOVIL_EXPIRA_MINUTOS=30

# Binance Pay (API v3). Las claves admiten PEM o base64 del PEM.
BINANCE_PAY_CERT_SN=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_WEBHOOK_PUBLIC_KEY=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
BINANCE_PAY_EXPIRA_MINUTOS=30

# Verificación de conductores. El OCR es opcional: sin proveedor configurado
# los documentos se guardan igual y la revisión queda 100% manual.
# OCR_PROVIDER: none | ocrspace | google_vision
OCR_PROVIDER=none
OCR_API_KEY=
OCR_ENDPOINT=
OCR_TIMEOUT_MS=12000
VERIFICACION_MAX_BYTES=5242880
