+++ b/server/src/security/whatsapp.js
@@ -0,0 +1,56 @@
+import { config } from "../config.js";
+
+// Supabase Auth envía el OTP mediante su Send SMS Hook (ver webhooks.js). Ese
+// hook llama a la API de Meta con la plantilla configurada. Si faltan las
+// credenciales, Supabase debe seguir usando su proveedor SMS normal.
+
+export function whatsappDisponible(whatsapp = config.otp.whatsapp) {
+  return Boolean(whatsapp.token && whatsapp.phoneId);
+}
+
+export async function enviarCodigoWhatsApp({
+  telefono,
+  codigo,
+  fetchImpl = globalThis.fetch,
+  whatsapp = config.otp.whatsapp,
+}) {
+  if (!whatsappDisponible(whatsapp)) {
+    throw new Error("whatsapp_no_configurado");
+  }
+
+  const para = String(telefono ?? "").replace(/\D/g, "");
+  if (para.length < 8) throw new Error("telefono_invalido");
+
+  const url = `https://graph.facebook.com/${whatsapp.apiVersion}/${whatsapp.phoneId}/messages`;
+  const cuerpo = {
+    messaging_product: "whatsapp",
+    to: para,
+    type: "template",
+    template: {
+      name: whatsapp.template,
+      language: { code: whatsapp.language },
+      components: [
+        {
+          type: "body",
+          parameters: [{ type: "text", text: String(codigo) }],
+        },
+      ],
+    },
+  };
+
+  const respuesta = await fetchImpl(url, {
+    method: "POST",
+    headers: {
+      Authorization: `Bearer ${whatsapp.token}`,
+      "Content-Type": "application/json",
+    },
+    body: JSON.stringify(cuerpo),
+  });
+
+  if (!respuesta.ok) {
+    const detalle = await respuesta.text().catch(() => "");
+    throw new Error(`whatsapp_${respuesta.status}: ${detalle.slice(0, 200)}`);
+  }
+
+  return { ok: true };
+}
diff --git a/server/src/verification/documents.js b/server/src/verification/documents.js
new file mode 100644
index 0000000..dac838f
--- /dev/null
+++ b/server/src/verification/documents.js
@@ -0,0 +1,87 @@
+import { createHash } from "node:crypto";
+import { HttpError } from "../http.js";
+
+const MIME_POR_FIRMA = [
+  { mime: "image/jpeg", firma: [0xff, 0xd8, 0xff] },
+  { mime: "image/png", firma: [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a] },
+  { mime: "application/pdf", firma: [0x25, 0x50, 0x44, 0x46] },
+];
+
+const EXTENSION = {
+  "image/jpeg": "jpg",
+  "image/png": "png",
+  "image/webp": "webp",
+  "application/pdf": "pdf",
+};
+
+const TIPOS = ["cedula_frente", "cedula_reverso", "licencia", "certificado_medico"];
+
+export { TIPOS as TIPOS_DOCUMENTO };
+
+function esWebp(buffer) {
+  return (
+    buffer.length >= 12 &&
+    buffer.subarray(0, 4).toString("ascii") === "RIFF" &&
+    buffer.subarray(8, 12).toString("ascii") === "WEBP"
+  );
+}
+
+export function detectarMime(buffer) {
+  for (const { mime, firma } of MIME_POR_FIRMA) {
+    if (buffer.length >= firma.length && firma.every((byte, indice) => buffer[indice] === byte)) {
+      return mime;
+    }
+  }
+  return esWebp(buffer) ? "image/webp" : null;
+}
+
+export function decodificarDocumento(body, { maxBytes }) {
+  const limpio = body.contenido_base64.replace(/\s+/g, "");
+  if (!/^[A-Za-z0-9+/]+={0,2}$/.test(limpio)) {
+    throw new HttpError(422, "documento_invalido", "El archivo no está codificado en base64 válido");
+  }
+
+  const buffer = Buffer.from(limpio, "base64");
+  if (buffer.length === 0) {
+    throw new HttpError(422, "documento_vacio", "El archivo está vacío");
+  }
+  if (buffer.length > maxBytes) {
+    throw new HttpError(
+      413,
+      "documento_muy_grande",
+      `El archivo supera el máximo de ${Math.round(maxBytes / (1024 * 1024))} MB`,
+    );
+  }
+
+  // El MIME declarado por el navegador no es confiable: se compara con los
+  // bytes reales del archivo.
+  const detectado = detectarMime(buffer);
+  if (!detectado) {
+    throw new HttpError(
+      422,
+      "formato_no_soportado",
+      "Sube una foto JPG, PNG, WebP o un PDF del documento",
+    );
+  }
+  if (body.mime !== detectado) {
+    throw new HttpError(
+      422,
+      "mime_no_coincide",
+      "El contenido del archivo no coincide con el formato declarado",
+    );
+  }
+
+  return { buffer, mime: detectado, bytes: buffer.length };
+}
+
+export function hashDocumento(buffer) {
+  return createHash("sha256").update(buffer).digest("hex");
+}
+
+export function rutaDocumento({ usuarioId, tipo, hash, mime }) {
+  return `${usuarioId}/${tipo}-${hash.slice(0, 16)}.${EXTENSION[mime]}`;
+}
+
+export function extensionDeMime(mime) {
+  return EXTENSION[mime] ?? null;
+}
diff --git a/server/src/verification/ocr.js b/server/src/verification/ocr.js
new file mode 100644
index 0000000..5ae43ff
--- /dev/null
+++ b/server/src/verification/ocr.js
@@ -0,0 +1,134 @@
+import { config } from "../config.js";
+
+// OCR opcional. Sin proveedor configurado la carga del documento sigue
+// funcionando: queda `no_configurado` y el operador revisa a mano. Un fallo del
+// proveedor tampoco bloquea al piloto; se registra `fallido` para auditoría.
+
+export function ocrDisponible(ocr = config.verification.ocr) {
+  if (!ocr.apiKey) return false;
+  return ocr.provider === "ocrspace" || ocr.provider === "google_vision";
+}
+
+function confianzaOcrSpace(resultado) {
+  const palabras = resultado?.TextOverlay?.Lines?.flatMap((linea) => linea.Words ?? []) ?? [];
+  const valores = palabras
+    .map((palabra) => Number(palabra.WordConfidence))
+    .filter((valor) => Number.isFinite(valor) && valor >= 0);
+  if (valores.length === 0) return 0.85;
+  return Math.min(1, Math.max(0, valores.reduce((suma, valor) => suma + valor, 0) / valores.length / 100));
+}
+
+async function ocrSpace({ buffer, mime, ocr, fetchImpl }) {
+  const endpoint = ocr.endpoint || "https://api.ocr.space/parse/image";
+  const form = new FormData();
+  form.append("base64Image", `data:${mime};base64,${buffer.toString("base64")}`);
+  form.append("language", "spa");
+  form.append("isOverlayRequired", "true");
+  form.append("OCREngine", "2");
+
+  const respuesta = await fetchImpl(endpoint, {
+    method: "POST",
+    headers: { apikey: ocr.apiKey },
+    body: form,
+  });
+  if (!respuesta.ok) throw new Error(`OCR.space respondió ${respuesta.status}`);
+
+  const datos = await respuesta.json();
+  if (datos?.IsErroredOnProcessing) {
+    const mensaje = Array.isArray(datos.ErrorMessage) ? datos.ErrorMessage.join(" ") : datos.ErrorMessage;
+    throw new Error(mensaje || "OCR.space no pudo leer el documento");
+  }
+
+  const primero = datos?.ParsedResults?.[0];
+  const texto = String(primero?.ParsedText ?? "").trim();
+  if (!texto) throw new Error("El OCR no encontró texto legible");
+
+  return {
+    texto,
+    confianza: confianzaOcrSpace(primero),
+    datos: { proveedor: "ocrspace", idioma: "spa" },
+  };
+}
+
+async function googleVision({ buffer, ocr, fetchImpl }) {
+  const endpoint = ocr.endpoint || "https://vision.googleapis.com/v1/images:annotate";
+  const url = new URL(endpoint);
+  if (!url.searchParams.get("key") && ocr.apiKey) url.searchParams.set("key", ocr.apiKey);
+
+  const respuesta = await fetchImpl(url.toString(), {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({
+      requests: [
+        {
+          image: { content: buffer.toString("base64") },
+          features: [{ type: "DOCUMENT_TEXT_DETECTION" }],
+        },
+      ],
+    }),
+  });
+  if (!respuesta.ok) throw new Error(`Google Vision respondió ${respuesta.status}`);
+
+  const datos = await respuesta.json();
+  const respuestaOcr = datos?.responses?.[0];
+  if (respuestaOcr?.error) throw new Error(respuestaOcr.error.message ?? "Google Vision rechazó el documento");
+
+  const texto = String(respuestaOcr?.fullTextAnnotation?.text ?? "").trim();
+  if (!texto) throw new Error("El OCR no encontró texto legible");
+
+  const confianza = Number(respuestaOcr?.fullTextAnnotation?.pages?.[0]?.confidence);
+
+  return {
+    texto,
+    confianza: Number.isFinite(confianza) ? Math.min(1, Math.max(0, confianza)) : 0.85,
+    datos: { proveedor: "google_vision", idioma: "es" },
+  };
+}
+
+export async function extraerTexto({
+  buffer,
+  mime,
+  fetchImpl = globalThis.fetch,
+  ocr = config.verification.ocr,
+}) {
+  if (!ocrDisponible(ocr)) {
+    return {
+      estado: "no_configurado",
+      texto: null,
+      confianza: null,
+      datos: { proveedor: ocr.provider || "none" },
+    };
+  }
+
+  const control = new AbortController();
+  const temporizador = setTimeout(() => control.abort(), ocr.timeoutMs);
+
+  try {
+    const proveedor = ocr.provider === "ocrspace" ? ocrSpace : googleVision;
+    const resultado = await proveedor({
+      buffer,
+      mime,
+      ocr,
+      fetchImpl: (url, opciones) => fetchImpl(url, { ...opciones, signal: control.signal }),
+    });
+
+    return {
+      estado: "listo",
+      texto: resultado.texto.slice(0, 20000),
+      confianza: resultado.confianza,
+      datos: resultado.datos,
+    };
+  } catch (error) {
+    return {
+      estado: "fallido",
+      texto: null,
+      confianza: null,
+      datos: {
+        proveedor: ocr.provider,
+        error: error?.name === "AbortError" ? "tiempo_agotado" : String(error?.message ?? "error").slice(0, 300),
+      },
+    };
+  } finally {
+    clearTimeout(temporizador);
+  }
+}
diff --git a/server/tests/binance.test.mjs b/server/tests/binance.test.mjs
new file mode 100644
index 0000000..559a833
--- /dev/null
+++ b/server/tests/binance.test.mjs
@@ -0,0 +1,276 @@
+import assert from "node:assert/strict";
+import { createVerify, generateKeyPairSync } from "node:crypto";
+import test from "node:test";
+
+// config.js exige estas variables; la firma no toca Supabase.
+process.env.SUPABASE_URL ||= "http://supabase.test";
+process.env.SUPABASE_ANON_KEY ||= "anon-test";
+
+const {
+  binanceDisponible,
+  crearOrdenBinance,
+  firmarSolicitudBinance,
+  leerEventoBinance,
+  verificarWebhookBinance,
+} = await import("../src/payments/binance.js");
+
+const { privateKey, publicKey } = generateKeyPairSync("rsa", {
+  modulusLength: 2048,
+  publicKeyEncoding: { type: "spki", format: "pem" },
+  privateKeyEncoding: { type: "pkcs8", format: "pem" },
+});
+
+const CERT_SN = "SN-TEST-001";
+const SERVER_KEY = "clave-servidor-de-prueba";
+const fetchOriginal = globalThis.fetch;
+
+function firmar({ body = '{"a":1}', timestamp = 1_790_000_000, nonce = "nonce-123" } = {}) {
+  return firmarSolicitudBinance({
+    body,
+    timestamp,
+    nonce,
+    privateKeyPem: privateKey,
+    certSn: CERT_SN,
+  });
+}
+
+test("la firma cubre timestamp, nonce y cuerpo con RSA-SHA256", () => {
+  const body = '{"merchantTradeNo":"LLG-0000000001"}';
+  const timestamp = 1_790_000_000;
+  const nonce = "abc123";
+  const headers = firmar({ body, timestamp, nonce });
+
+  assert.equal(headers["BinancePay-Timestamp"], String(timestamp));
+  assert.equal(headers["BinancePay-Nonce"], nonce);
+  assert.equal(headers["BinancePay-Certificate-SN"], CERT_SN);
+  assert.equal(headers["content-type"], "application/json");
+
+  const verifier = createVerify("RSA-SHA256");
+  verifier.update(`${timestamp}\n${nonce}\n${body}\n`);
+  verifier.end();
+  assert.equal(verifier.verify(publicKey, headers["BinancePay-Signature"], "base64"), true);
+});
+
+test("el webhook válido pasa y el cuerpo alterado no", () => {
+  const rawBody = '{"bizStatus":"PAY_SUCCESS","data":{"merchantTradeNo":"LLG-0000000001","orderAmount":10}}';
+  const timestamp = "1790000000";
+  const nonce = "nonce-456";
+  const signature = firmar({ body: rawBody, timestamp: Number(timestamp), nonce })["BinancePay-Signature"];
+  const now = Number(timestamp) * 1000;
+
+  assert.equal(
+    verificarWebhookBinance({ rawBody, timestamp, nonce, signature, publicKeyPem: publicKey, now }),
+    true,
+  );
+  assert.equal(
+    verificarWebhookBinance({
+      rawBody: rawBody.replace("10", "900"),
+      timestamp,
+      nonce,
+      signature,
+      publicKeyPem: publicKey,
+      now,
+    }),
+    false,
+  );
+});
+
+test("el webhook viejo o firmado con otra clave se rechaza", () => {
+  const rawBody = '{"bizStatus":"PAY_SUCCESS"}';
+  const timestamp = "1790000000";
+  const nonce = "nonce-789";
+  const signature = firmar({ body: rawBody, timestamp: Number(timestamp), nonce })["BinancePay-Signature"];
+
+  assert.equal(
+    verificarWebhookBinance({
+      rawBody,
+      timestamp,
+      nonce,
+      signature,
+      publicKeyPem: publicKey,
+      now: (Number(timestamp) + 301) * 1000,
+    }),
+    false,
+  );
+
+  const otraClave = generateKeyPairSync("rsa", {
+    modulusLength: 2048,
+    publicKeyEncoding: { type: "spki", format: "pem" },
+    privateKeyEncoding: { type: "pkcs8", format: "pem" },
+  }).publicKey;
+  assert.equal(
+    verificarWebhookBinance({
+      rawBody,
+      timestamp,
+      nonce,
+      signature,
+      publicKeyPem: otraClave,
+      now: Number(timestamp) * 1000,
+    }),
+    false,
+  );
+
+  assert.equal(
+    verificarWebhookBinance({ rawBody, timestamp: "", nonce, signature, publicKeyPem: publicKey }),
+    false,
+  );
+});
+
+test("Binance solo se ofrece con todas las credenciales", () => {
+  const completo = {
+    certSn: CERT_SN,
+    secretKey: privateKey,
+    webhookPublicKey: publicKey,
+  };
+
+  assert.equal(binanceDisponible(completo, SERVER_KEY), true);
+  assert.equal(binanceDisponible(completo, ""), false);
+  assert.equal(binanceDisponible({ ...completo, certSn: "" }, SERVER_KEY), false);
+  assert.equal(binanceDisponible({ ...completo, secretKey: "" }, SERVER_KEY), false);
+  assert.equal(binanceDisponible({ ...completo, webhookPublicKey: "no-es-pem" }, SERVER_KEY), false);
+});
+
+test("las credenciales en base64 o con saltos escapados son aceptadas", async (t) => {
+  t.after(() => {
+    globalThis.fetch = fetchOriginal;
+  });
+
+  const enBase64 = {
+    certSn: CERT_SN,
+    secretKey: Buffer.from(privateKey).toString("base64"),
+    webhookPublicKey: Buffer.from(publicKey).toString("base64"),
+    baseUrl: "https://bpay.test",
+  };
+  assert.equal(binanceDisponible(enBase64, SERVER_KEY), true);
+  assert.equal(
+    binanceDisponible(
+      {
+        certSn: CERT_SN,
+        secretKey: privateKey.replace(/\n/g, "\\n"),
+        webhookPublicKey: publicKey.replace(/\n/g, "\\n"),
+      },
+      SERVER_KEY,
+    ),
+    true,
+  );
+
+  let enviado;
+  globalThis.fetch = async (_url, init) => {
+    enviado = init;
+    return new Response(
+      JSON.stringify({ status: "SUCCESS", code: "000000", data: { checkoutUrl: "https://pay.binance.test/checkout/b64" } }),
+      { status: 200, headers: { "content-type": "application/json" } },
+    );
+  };
+
+  const orden = await crearOrdenBinance({ montoUsd: 10, codigo: "LLG-0000000008" }, enBase64, SERVER_KEY);
+  assert.equal(orden.checkoutUrl, "https://pay.binance.test/checkout/b64");
+
+  const verifier = createVerify("RSA-SHA256");
+  verifier.update(
+    `${enviado.headers["BinancePay-Timestamp"]}\n${enviado.headers["BinancePay-Nonce"]}\n${enviado.body}\n`,
+  );
+  verifier.end();
+  assert.equal(verifier.verify(publicKey, enviado.headers["BinancePay-Signature"], "base64"), true);
+});
+
+test("el evento de Binance se lee con datos en objeto o en texto", () => {
+  const data = { merchantTradeNo: "LLG-0000000002", orderAmount: "25.5", prepayId: "PP-1" };
+
+  const objeto = leerEventoBinance({ bizStatus: "PAY_SUCCESS", data });
+  assert.deepEqual(
+    { estado: objeto.estado, codigo: objeto.codigo, montoUsd: objeto.montoUsd, referenciaExterna: objeto.referenciaExterna },
+    { estado: "PAY_SUCCESS", codigo: "LLG-0000000002", montoUsd: 25.5, referenciaExterna: "PP-1" },
+  );
+
+  const texto = leerEventoBinance({ data: JSON.stringify(data) });
+  assert.equal(texto.codigo, "LLG-0000000002");
+  assert.equal(texto.montoUsd, 25.5);
+
+  assert.equal(leerEventoBinance(null), null);
+  assert.equal(leerEventoBinance({ data: "{roto" }), null);
+  assert.equal(leerEventoBinance({ data: "sin-json" }), null);
+});
+
+test("crear la orden exige configuración completa", async () => {
+  await assert.rejects(
+    crearOrdenBinance({ montoUsd: 10, codigo: "LLG-0000000003" }, { certSn: "", secretKey: "", webhookPublicKey: "", baseUrl: "https://bpay.test" }, SERVER_KEY),
+    (error) => error.status === 503 && error.code === "binance_no_configurado",
+  );
+});
+
+test("crear la orden firma el cuerpo y devuelve el checkout", async (t) => {
+  const calls = [];
+  t.after(() => {
+    globalThis.fetch = fetchOriginal;
+  });
+  globalThis.fetch = async (url, init) => {
+    calls.push({ url, init });
+    return new Response(
+      JSON.stringify({
+        status: "SUCCESS",
+        code: "000000",
+        data: { checkoutUrl: "https://pay.binance.test/checkout/1", prepayId: "PP-9", merchantTradeNo: "LLG-0000000004" },
+      }),
+      { status: 200, headers: { "content-type": "application/json" } },
+    );
+  };
+
+  const orden = await crearOrdenBinance(
+    { montoUsd: 9.9, codigo: "LLG-0000000004" },
+    { certSn: CERT_SN, secretKey: privateKey, webhookPublicKey: publicKey, baseUrl: "https://bpay.test/" },
+    SERVER_KEY,
+  );
+
+  assert.equal(orden.checkoutUrl, "https://pay.binance.test/checkout/1");
+  assert.equal(orden.prepayId, "PP-9");
+  assert.equal(calls.length, 1);
+  assert.equal(calls[0].url, "https://bpay.test/binancepay/openapi/v3/order");
+
+  const enviado = JSON.parse(calls[0].init.body);
+  assert.equal(enviado.merchantTradeNo, "LLG-0000000004");
+  assert.equal(enviado.orderAmount, 9.9);
+  assert.equal(enviado.currency, "USDT");
+
+  const verifier = createVerify("RSA-SHA256");
+  verifier.update(
+    `${calls[0].init.headers["BinancePay-Timestamp"]}\n${calls[0].init.headers["BinancePay-Nonce"]}\n${calls[0].init.body}\n`,
+  );
+  verifier.end();
+  assert.equal(verifier.verify(publicKey, calls[0].init.headers["BinancePay-Signature"], "base64"), true);
+});
+
+test("crear la orden rechaza respuestas sin checkout", async (t) => {
+  t.after(() => {
+    globalThis.fetch = fetchOriginal;
+  });
+  const options = { certSn: CERT_SN, secretKey: privateKey, webhookPublicKey: publicKey, baseUrl: "https://bpay.test" };
+
+  globalThis.fetch = async () =>
+    new Response(JSON.stringify({ status: "SUCCESS", code: "000000", data: {} }), {
+      status: 200,
+      headers: { "content-type": "application/json" },
+    });
+  await assert.rejects(
+    crearOrdenBinance({ montoUsd: 10, codigo: "LLG-0000000005" }, options, SERVER_KEY),
+    (error) => error.status === 502 && error.code === "binance_sin_checkout",
+  );
+
+  globalThis.fetch = async () =>
+    new Response(JSON.stringify({ status: "FAIL", code: "400001", errorMessage: "monto inválido" }), {
+      status: 400,
+      headers: { "content-type": "application/json" },
+    });
+  await assert.rejects(
+    crearOrdenBinance({ montoUsd: 10, codigo: "LLG-0000000006" }, options, SERVER_KEY),
+    (error) => error.status === 502 && error.message === "monto inválido",
+  );
+
+  globalThis.fetch = async () => {
+    throw new TypeError("failed to fetch");
+  };
+  await assert.rejects(
+    crearOrdenBinance({ montoUsd: 10, codigo: "LLG-0000000007" }, options, SERVER_KEY),
+    (error) => error.status === 502 && error.code === "binance_sin_respuesta",
+  );
+});
diff --git a/server/tests/ocr.test.mjs b/server/tests/ocr.test.mjs
new file mode 100644
index 0000000..f1c0583
--- /dev/null
+++ b/server/tests/ocr.test.mjs
@@ -0,0 +1,144 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+// ocr.js importa config.js, que exige estas variables al cargar.
+process.env.SUPABASE_URL = "http://127.0.0.1:1";
+process.env.SUPABASE_ANON_KEY = "clave-anon-de-prueba";
+
+const { extraerTexto, ocrDisponible } = await import("../src/verification/ocr.js");
+
+const BUFFER = Buffer.from("documento-de-prueba");
+
+test("sin proveedor configurado el OCR no se intenta", async () => {
+  let llamado = false;
+  const resultado = await extraerTexto({
+    buffer: BUFFER,
+    mime: "image/png",
+    ocr: { provider: "none", apiKey: "" },
+    fetchImpl: async () => {
+      llamado = true;
+    },
+  });
+
+  assert.equal(llamado, false);
+  assert.equal(resultado.estado, "no_configurado");
+  assert.equal(resultado.texto, null);
+  assert.equal(resultado.confianza, null);
+});
+
+test("ocrDisponible exige proveedor conocido y clave", () => {
+  assert.equal(ocrDisponible({ provider: "ocrspace", apiKey: "k" }), true);
+  assert.equal(ocrDisponible({ provider: "google_vision", apiKey: "k" }), true);
+  assert.equal(ocrDisponible({ provider: "ocrspace", apiKey: "" }), false);
+  assert.equal(ocrDisponible({ provider: "otro", apiKey: "k" }), false);
+});
+
+test("OCR.space envía el documento en base64 y promedia la confianza", async () => {
+  let solicitud;
+  const fetchImpl = async (url, opciones) => {
+    solicitud = { url, opciones };
+    return new Response(
+      JSON.stringify({
+        ParsedResults: [
+          {
+            ParsedText: "República Bolivariana\nV-12345678",
+            TextOverlay: {
+              Lines: [{ Words: [{ WordConfidence: 90 }, { WordConfidence: 70 }] }],
+            },
+          },
+        ],
+      }),
+      { status: 200, headers: { "content-type": "application/json" } },
+    );
+  };
+
+  const resultado = await extraerTexto({
+    buffer: BUFFER,
+    mime: "image/png",
+    ocr: { provider: "ocrspace", apiKey: "clave", endpoint: "", timeoutMs: 2000 },
+    fetchImpl,
+  });
+
+  assert.equal(solicitud.url, "https://api.ocr.space/parse/image");
+  assert.equal(solicitud.opciones.headers.apikey, "clave");
+  assert.equal(solicitud.opciones.body.get("language"), "spa");
+  assert.equal(
+    solicitud.opciones.body.get("base64Image"),
+    `data:image/png;base64,${BUFFER.toString("base64")}`,
+  );
+  assert.equal(resultado.estado, "listo");
+  assert.equal(resultado.texto, "República Bolivariana\nV-12345678");
+  assert.equal(resultado.confianza, 0.8);
+  assert.equal(resultado.datos.proveedor, "ocrspace");
+});
+
+test("Google Vision usa la clave en la URL y la confianza de la página", async () => {
+  let urlPedida;
+  const fetchImpl = async (url) => {
+    urlPedida = new URL(url);
+    return new Response(
+      JSON.stringify({
+        responses: [
+          {
+            fullTextAnnotation: {
+              text: "V-12345678 ANA CLIENTE",
+              pages: [{ confidence: 0.93 }],
+            },
+          },
+        ],
+      }),
+      { status: 200, headers: { "content-type": "application/json" } },
+    );
+  };
+
+  const resultado = await extraerTexto({
+    buffer: BUFFER,
+    mime: "image/jpeg",
+    ocr: { provider: "google_vision", apiKey: "clave-google", endpoint: "", timeoutMs: 2000 },
+    fetchImpl,
+  });
+
+  assert.equal(urlPedida.origin, "https://vision.googleapis.com");
+  assert.equal(urlPedida.searchParams.get("key"), "clave-google");
+  assert.equal(resultado.estado, "listo");
+  assert.equal(resultado.texto, "V-12345678 ANA CLIENTE");
+  assert.equal(resultado.confianza, 0.93);
+  assert.equal(resultado.datos.proveedor, "google_vision");
+});
+
+test("un fallo del proveedor no bloquea la carga del documento", async () => {
+  const fetchImpl = async () =>
+    new Response(JSON.stringify({ error: "sin cuota" }), {
+      status: 429,
+      headers: { "content-type": "application/json" },
+    });
+
+  const resultado = await extraerTexto({
+    buffer: BUFFER,
+    mime: "image/png",
+    ocr: { provider: "ocrspace", apiKey: "clave", endpoint: "", timeoutMs: 2000 },
+    fetchImpl,
+  });
+
+  assert.equal(resultado.estado, "fallido");
+  assert.equal(resultado.texto, null);
+  assert.match(resultado.datos.error, /429/);
+});
+
+test("un documento sin texto legible queda como fallido", async () => {
+  const fetchImpl = async () =>
+    new Response(JSON.stringify({ ParsedResults: [{ ParsedText: "   " }] }), {
+      status: 200,
+      headers: { "content-type": "application/json" },
+    });
+
+  const resultado = await extraerTexto({
+    buffer: BUFFER,
+    mime: "image/png",
+    ocr: { provider: "ocrspace", apiKey: "clave", endpoint: "", timeoutMs: 2000 },
+    fetchImpl,
+  });
+
+  assert.equal(resultado.estado, "fallido");
+  assert.match(resultado.datos.error, /texto legible/);
+});
diff --git a/server/tests/otpWebhook.test.mjs b/server/tests/otpWebhook.test.mjs
new file mode 100644
index 0000000..8c51451
--- /dev/null
+++ b/server/tests/otpWebhook.test.mjs
@@ -0,0 +1,130 @@
+import assert from "node:assert/strict";
+import { createHmac } from "node:crypto";
+import test from "node:test";
+
+// webhooks.js importa config.js, que exige estas variables al cargar.
+process.env.SUPABASE_URL = "http://127.0.0.1:1";
+process.env.SUPABASE_ANON_KEY = "clave-anon-de-prueba";
+
+const { firmaHookValida } = await import("../src/routes/webhooks.js");
+const { enviarCodigoWhatsApp, whatsappDisponible } = await import("../src/security/whatsapp.js");
+
+const SECRETO = Buffer.from("secreto-del-hook-de-prueba");
+const ID = "msg_01J0000000000000000000000";
+const CUERPO = JSON.stringify({
+  user: { phone: "+584141234567" },
+  sms: { otp: "123456" },
+});
+
+function firmar(cuerpo, timestamp, secreto = SECRETO) {
+  return createHmac("sha256", secreto).update(`${ID}.${timestamp}.${cuerpo}`).digest("base64");
+}
+
+test("la firma del Send SMS Hook acepta el formato v1 del estándar Webhooks", () => {
+  const timestamp = String(Math.floor(Date.now() / 1000));
+  const firma = firmar(CUERPO, timestamp);
+
+  assert.equal(firmaHookValida({ rawBody: CUERPO, id: ID, timestamp, firma: `v1,${firma}`, secreto: SECRETO }), true);
+  assert.equal(
+    firmaHookValida({
+      rawBody: CUERPO,
+      id: ID,
+      timestamp,
+      firma: `v1,AAAA v1,${firma}`,
+      secreto: SECRETO,
+    }),
+    true,
+  );
+});
+
+test("la firma rechaza cuerpos alterados, secretos distintos y firmas vacías", () => {
+  const timestamp = String(Math.floor(Date.now() / 1000));
+  const firma = firmar(CUERPO, timestamp);
+
+  assert.equal(
+    firmaHookValida({ rawBody: `${CUERPO} `, id: ID, timestamp, firma: `v1,${firma}`, secreto: SECRETO }),
+    false,
+  );
+  assert.equal(
+    firmaHookValida({
+      rawBody: CUERPO,
+      id: ID,
+      timestamp,
+      firma: `v1,${firma}`,
+      secreto: Buffer.from("otro-secreto"),
+    }),
+    false,
+  );
+  assert.equal(firmaHookValida({ rawBody: CUERPO, id: ID, timestamp, firma: "", secreto: SECRETO }), false);
+});
+
+test("la firma caduca para evitar reenvíos", () => {
+  const viejo = String(Math.floor(Date.now() / 1000) - 900);
+  const firma = firmar(CUERPO, viejo);
+
+  assert.equal(firmaHookValida({ rawBody: CUERPO, id: ID, timestamp: viejo, firma: `v1,${firma}`, secreto: SECRETO }), false);
+});
+
+test("WhatsApp arma la plantilla de OTP con el número normalizado", async () => {
+  let solicitud;
+  const fetchImpl = async (url, opciones) => {
+    solicitud = { url, opciones };
+    return new Response("{}", { status: 200, headers: { "content-type": "application/json" } });
+  };
+  const whatsapp = {
+    token: "token-meta",
+    phoneId: "123456789",
+    template: "llegate_otp",
+    language: "es",
+    apiVersion: "v21.0",
+  };
+
+  const resultado = await enviarCodigoWhatsApp({
+    telefono: "+58 414-1234567",
+    codigo: "123456",
+    fetchImpl,
+    whatsapp,
+  });
+
+  assert.deepEqual(resultado, { ok: true });
+  assert.equal(solicitud.url, "https://graph.facebook.com/v21.0/123456789/messages");
+  assert.equal(solicitud.opciones.headers.Authorization, "Bearer token-meta");
+
+  const cuerpo = JSON.parse(solicitud.opciones.body);
+  assert.equal(cuerpo.messaging_product, "whatsapp");
+  assert.equal(cuerpo.to, "584141234567");
+  assert.equal(cuerpo.template.name, "llegate_otp");
+  assert.deepEqual(cuerpo.template.language, { code: "es" });
+  assert.deepEqual(cuerpo.template.components[0].parameters, [{ type: "text", text: "123456" }]);
+});
+
+test("sin credenciales de Meta no se intenta enviar", async () => {
+  assert.equal(whatsappDisponible({ token: "", phoneId: "1" }), false);
+  assert.equal(whatsappDisponible({ token: "t", phoneId: "" }), false);
+  assert.equal(whatsappDisponible({ token: "t", phoneId: "1" }), true);
+
+  await assert.rejects(
+    () =>
+      enviarCodigoWhatsApp({
+        telefono: "+584141234567",
+        codigo: "123456",
+        whatsapp: { token: "", phoneId: "" },
+      }),
+    /whatsapp_no_configurado/,
+  );
+});
+
+test("un 4xx de Meta se reporta como error del proveedor", async () => {
+  const fetchImpl = async () => new Response("token inválido", { status: 401 });
+
+  await assert.rejects(
+    () =>
+      enviarCodigoWhatsApp({
+        telefono: "+584141234567",
+        codigo: "123456",
+        fetchImpl,
+        whatsapp: { token: "t", phoneId: "1", template: "tpl", language: "es", apiVersion: "v21.0" },
+      }),
+    /whatsapp_401/,
+  );
+});
