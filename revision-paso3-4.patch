+export function maskPhone(phone: string | null) {
+  if (!phone) return "—";
+  const digits = phone.replace(/\D/g, "");
+  if (digits.length < 6) return phone;
+  const prefix = phone.trim().startsWith("+") ? `+${digits.slice(0, 2)} ` : "";
+  return `${prefix}••• ${digits.slice(-4)}`;
+}
